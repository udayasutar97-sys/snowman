PORT=5000

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3-vl:8b-instruct-q4_K_M
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct-q4_K_M

# Image model (FLUX.2 Klein 4B)
OLLAMA_IMAGE_MODEL=x/flux2-klein:4b

# Default size (start with 512; if slow, drop to 384)
IMAGE_WIDTH=512
IMAGE_HEIGHT=512

# Steps (keep modest; bump later if quality too low)
IMAGE_STEPS=12

#timeout (10 min)
IMAGE_GEN_TIMEOUT_MS=600000
